# Copia este archivo como .env. No publiques .env ni claves reales.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_ENABLED=false
AI_MIN_CONFIDENCE=60

EXCHANGE_ID=binance
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=1h
OHLCV_LIMIT=260
LOOP_INTERVAL_SECONDS=420
USE_TESTNET=true
PAPER_TRADING=true

INITIAL_CAPITAL=100
RISK_PER_TRADE_PCT=0.01
MAX_DRAWDOWN_PCT=0.15
MAX_TOTAL_EXPOSURE_PCT=0.40
STOP_ATR_MULTIPLE=2.0
TAKE_PROFIT_R_MULTIPLE=2.0
TRADING_FEE_PCT=0.001
SLIPPAGE_PCT=0.0005
MIN_NOTIONAL=5
